# 이 파일을 .env 로 복사한 뒤 값을 채우세요.  cp .env.example .env
# 실제 .env 는 절대 커밋하지 마세요(.gitignore 에 포함).
#
# 실험 2(검증 항상=s2)·실험 3(동적 신뢰도 캐스케이드=s5)은 gemini-2.5-flash 단일 모델만 쓴다(논문 3.2.1).
# => GOOGLE_API_KEY 하나만 채우면 실험 실행 가능. (OPENAI/ANTHROPIC/임베딩 키는 실험2·3에 불필요)
# => 메일/진행보고를 쓰려면 SMTP_* 도 채우고 SEND_EMAIL=1 로 둔다(STEP 11).

# --- LLM API Key (필수) ---
GOOGLE_API_KEY=
# 실제 모델 문자열
MODEL_GEMINI_FLASH=gemini-2.5-flash

# --- 실험 3 게이트 임계값(선택) ---
# 미설정 시 config/experiment.yaml 의 s5_confidence_threshold(기본 0.7) 사용.
# 스윕 시 S5_THRESHOLD=0.5 ... 0.9 로 오버라이드(또는 ./run.sh 호출 앞에 S5_THRESHOLD=T).
# S5_THRESHOLD=0.7

# --- 메일(SMTP) — 진행보고/완료/중단 알림 발송용 (STEP 11) ---
# Gmail 은 2단계 인증 후 '앱 비밀번호'를 SMTP_PASSWORD 에 넣는다.
SEND_EMAIL=1
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
MAIL_TO=

# --- 비용 상한(선택, USD). 초과 시 일시정지 + 경고 메일 ---
# COST_CAP_USD=

# --- (실험2·3 에는 불필요) 예비실험용 추가 키 ---
# 아래는 s1/s3/s4 등 예비실험 또는 임베딩 검색 경로에서만 필요. 실험2·3 self-contained 경로에선 미사용.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# MODEL_GEMINI_PRO=gemini-3.1-pro
# MODEL_GPT4O_MINI=gpt-4o-mini
# MODEL_CLAUDE_HAIKU=claude-haiku-4.5
# MODEL_CLAUDE_SONNET=claude-sonnet-4-5
# MODEL_O3=o3
# MODEL_O4_MINI=o4-mini
# EMBEDDING_MODEL=text-embedding-3-small
# CHROMA_DIR=./data/chroma
