# 이 파일을 .env 로 복사한 뒤 값을 채우세요.  cp .env.example .env
# 실제 .env 는 절대 커밋하지 마세요(.gitignore 에 포함).

# --- LLM API Keys ---
GOOGLE_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# o3 가 OpenAI 경유면 OPENAI_API_KEY 재사용, 별도면 아래 주석 해제 후 사용
# OPENAI_O3_API_KEY=

# --- 실제 모델 문자열 (배포 시점 확인 후 입력) ---
MODEL_GEMINI_FLASH=gemini-2.5-flash
MODEL_GEMINI_PRO=gemini-3.1-pro
MODEL_GPT4O_MINI=gpt-4o-mini
MODEL_CLAUDE_HAIKU=claude-haiku-4.5
MODEL_O3=o3

# --- 메일(SMTP) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
MAIL_TO=thomas@itengineers.net

# --- 기타 ---
EMBEDDING_MODEL=text-embedding-3-small
CHROMA_DIR=./data/chroma

# --- 선택: 비용 안전장치 (USD). 미설정 시 무제한 ---
# COST_CAP_USD=

# --- 선택: 메일 비활성화(테스트) — 0 이면 발송 안 함 ---
# SEND_EMAIL=1
# (참고) K-DART 검색 인덱스는 이미 구축된 것을 data/chroma 로 복사해 쓰므로 DART_API_KEY 불필요.
